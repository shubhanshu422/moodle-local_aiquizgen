<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/aiquizgen/db" VERSION="2026100901" COMMENT="AI quiz generator tables">
  <TABLES>
    <TABLE NAME="local_aiquizgen_jobs" COMMENT="Generation jobs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="queued"/>
        <FIELD NAME="configjson" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="error" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="questioncount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="inputtokens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="outputtokens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="apicalls" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="estimatedcost" TYPE="number" LENGTH="12" DECIMALS="6" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="model" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="unknown"/>
        <FIELD NAME="retryof" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="courseuser" UNIQUE="false" FIELDS="courseid,userid"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_aiquizgen_questions" COMMENT="Generated questions pending approval">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="jobid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="questiontext" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="answersjson" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="correctanswer" TYPE="int" LENGTH="2" NOTNULL="true"/>
        <FIELD NAME="explanation" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="sourceref" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="approved" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="jobfk" TYPE="foreign" FIELDS="jobid" REFTABLE="local_aiquizgen_jobs" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
